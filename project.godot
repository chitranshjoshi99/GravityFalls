; Engine configuration file.
; Doc 01 §0 locks the three display values below. They are set here once and
; restated nowhere else: Doc 03's CELL grid and Doc 04's absolute pixel layout
; are both authored against a true 1920x1080 canvas, and `keep` is what makes
; that canvas honest on the 16:10 panels this game targets.

config_version=5

[application]

config/name="Gravity Falls"
config/features=PackedStringArray("4.4")

[autoload]

; Doc 00 §2.2's registration order is load-bearing: an autoload may only
; reference autoloads registered above it during _ready().
Tokens="*res://autoload/tokens.gd"
Weirdness="*res://autoload/weirdness.gd"
Settings="*res://autoload/settings.gd"
GameState="*res://autoload/game_state.gd"
RuntimeEvents="*res://autoload/runtime_events.gd"
; Doc 00 §2.2 places RuntimeDirector twelfth and LAST. Rows 0.11, 0.12 and 2.3
; insert AudioDirector, Combat/Cutscene/TransitionDirector, ZoneManager and
; SessionDirector ABOVE this line, never below it: the resolver reaches for all
; of them, and an autoload may only reference autoloads registered above it.
RuntimeDirector="*res://autoload/runtime_director.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
